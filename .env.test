# Copy to .env.test. The tests DELETE ALL DATA in this database, so never point it at your real one.
# Only a local database is accepted unless TEST_ORACLE_ALLOW_REMOTE=true.
#
# A throwaway local Oracle (needs Docker; the first start takes a couple of minutes):
#   docker run -d --name aluthjob-oracle-test -p 1521:1521 -e ORACLE_PASSWORD=test_admin_pw -e APP_USER=aluthtest -e APP_USER_PASSWORD=test_user_pw gvenzl/oracle-free:slim
TEST_ORACLE_USER=aluthtest
TEST_ORACLE_PASSWORD=test_user_pw
TEST_ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1
