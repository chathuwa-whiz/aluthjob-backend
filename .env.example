# Copy to .env and fill in. Never commit the real .env.

PORT=4000

# SQLite file (created on first start)
DATABASE_PATH=data/aluthjob.db

# --- Local AI (Ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Reads resumes
OLLAMA_MODEL=qwen3.5:2b
# Writes cover letters; a larger model follows the "use only the facts" rules far more reliably.
# Leave unset to reuse OLLAMA_MODEL.
OLLAMA_LETTER_MODEL=
OLLAMA_NUM_THREADS=4

# --- Job collection ---
# Vacancies are collected from the job sites automatically. A first search on an empty database collects them
# first (and tells the person), and the server refreshes them in the background on this schedule.
# Minutes between automatic collections; 0 turns the schedule off (then only `npm run ingest` and a first search collect).
INGEST_INTERVAL_MINUTES=360
# Vacancies older than this many hours are refreshed in the background when someone searches
COLLECTION_MAX_AGE_HOURS=12
# Pages read per job site in each collection
INGEST_MAX_PAGES=3

# --- Sending applications ---
# REQUIRED to connect mailboxes and send. Encrypts mailbox passwords in the database.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If this changes, stored mailbox passwords can no longer be read and users must reconnect.
MAIL_SECRET=
# Applications one candidate may send per rolling 24 hours (keeps their mailbox out of spam filters)
MAIL_DAILY_LIMIT=20
# Minimum pause between two applications from the same candidate
MAIL_SEND_GAP_SECONDS=60
# Set to "off" to run the API without the background sender
MAIL_WORKER=on
# Development only: allow a mail server on localhost / private addresses (a mail catcher).
# Never set this in production; it disables the protection against internal-network connections.
# MAIL_ALLOW_LOCAL=true

# --- Reading picture adverts (OCR) ---
# TopJobs adverts are mostly images. They are read with Tesseract (pure JavaScript, nothing to install).
# The language data (about 10 MB per language) is downloaded from a CDN on first use and cached here;
# to run offline, put eng.traineddata in this folder beforehand.
OCR_CACHE_PATH=data/tessdata
# Space-free list, e.g. eng or eng+sin (Sinhala) - each extra language is slower and downloads more data
OCR_LANGUAGES=eng
# An address read from a picture is only offered if the engine is at least this sure of it (0-100).
# Kept low on purpose: correct addresses on designed posters often score 45-60. The mail-domain check
# and the user's own confirmation are the real safeguards.
OCR_MIN_EMAIL_CONFIDENCE=40
# Servers used to verify that an address's domain exists and receives mail (comma separated).
# Only the domain name is sent, never the address.
DNS_SERVERS=1.1.1.1,8.8.8.8,9.9.9.9
# Adverts read per scheduled run (after each collection). The TopJobs backlog shrinks by this many each time; 0 = off.
ENRICH_PER_RUN=40

# --- Accounts and sign-in ---
# Browser origin(s) allowed to call the API and to send the session cookie (comma separated). Required for a separate front end.
FRONTEND_URL=http://localhost:3000
# Days a sign-in lasts (the session is a random token; only its hash is stored)
SESSION_DAYS=30
# The session cookie is always HttpOnly and SameSite=Lax. "Secure" (https only) is on automatically when
# NODE_ENV=production; set true/false here to override.
# COOKIE_SECURE=true
# Behind a reverse proxy (nginx, Caddy) set the number of proxies, usually 1, so the real visitor address is
# used for rate limits. Leave unset when the API is exposed directly.
# TRUST_PROXY=1
# Password hashing work factor (scrypt N, a power of two). Higher = slower for attackers and for logins.
# AUTH_SCRYPT_COST=32768

# --- Email the service itself sends (confirm your address, reset your password) ---
# These come from ONE sender that you run; they are not the users' own mailboxes (those send job applications).
# Without SYSTEM_SMTP_HOST: in development the emails are printed to the console so you can follow the links;
# in production (NODE_ENV=production) registration is refused with a clear error, because accounts could never be confirmed.
# Any SMTP provider works: your own Postfix, Brevo, Mailgun, Amazon SES, ...
SYSTEM_SMTP_HOST=
SYSTEM_SMTP_PORT=587
# true = TLS from the first byte (port 465); empty = true only for port 465, otherwise STARTTLS
SYSTEM_SMTP_SECURE=
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASS=
# Required when SYSTEM_SMTP_HOST is set. Use an address on a domain you control, with SPF/DKIM set up,
# or the messages will land in spam.
SYSTEM_MAIL_FROM="AluthJob <no-reply@yourdomain.com>"
# Where the links in those emails lead: the address of your web front end (no trailing slash needed).
# Defaults to the first FRONTEND_URL.
APP_URL=
